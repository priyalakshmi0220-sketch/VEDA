<script>
      function selectRole(role) {
        const tabs = ['customer', 'provider', 'admin'];
        tabs.forEach(t => {
          const el = document.getElementById('tab-' + t);
          if (t === role) {
            el.className = 'py-2 rounded-lg text-xs font-bold tracking-wider uppercase text-[#1e0e1a] bg-[#CDC694] transition-all shadow-md font-headline';
          } else {
            el.className = 'py-2 rounded-lg text-xs font-bold tracking-wider uppercase text-[#CDC694]/70 hover:text-[#FFFDEF] transition-all font-headline';
          }
        });

        const submitBtn = document.getElementById('submit-btn');
        if (role === 'customer') {
          submitBtn.querySelector('.relative.z-10').innerHTML = `
            Sign In to Samay
            <span class="material-symbols-outlined text-base transition-transform group-hover:translate-x-1">arrow_forward</span>
          `;
        } else if (role === 'provider') {
          submitBtn.querySelector('.relative.z-10').innerHTML = `
            Enter Provider Portal
            <span class="material-symbols-outlined text-base transition-transform group-hover:translate-x-1">calendar_month</span>
          `;
        } else {
          submitBtn.querySelector('.relative.z-10').innerHTML = `
            Access Admin Console
            <span class="material-symbols-outlined text-base transition-transform group-hover:translate-x-1">shield_person</span>
          `;
        }
      }

      function togglePasswordVisibility() {
        const pwdInput = document.getElementById('auth-password');
        const icon = document.getElementById('eye-icon');
        if (pwdInput.type === 'password') {
          pwdInput.type = 'text';
          pwdInput.classList.remove('tracking-widest');
          icon.textContent = 'visibility_off';
        } else {
          pwdInput.type = 'password';
          pwdInput.classList.add('tracking-widest');
          icon.textContent = 'visibility';
        }
      }

      function setDemoPersona(email, password, role) {
        const emailField = document.getElementById('auth-email');
        const pwdField = document.getElementById('auth-password');
        
        emailField.value = email;
        pwdField.value = password;
        selectRole(role);

        emailField.classList.add('ring-2', 'ring-[#CDC694]');
        pwdField.classList.add('ring-2', 'ring-[#CDC694]');
        setTimeout(() => {
          emailField.classList.remove('ring-2', 'ring-[#CDC694]');
          pwdField.classList.remove('ring-2', 'ring-[#CDC694]');
        }, 500);
      }

      function triggerAuth() {
        const submitBtn = document.getElementById('submit-btn');
        const originalContent = submitBtn.innerHTML;
        
        submitBtn.disabled = true;
        submitBtn.innerHTML = `
          <span class="relative z-10 flex items-center gap-2 text-[#1e0e1a] font-bold font-headline uppercase tracking-wide">
            <span class="animate-spin material-symbols-outlined text-sm">progress_activity</span>
            Authenticating with Samay...
          </span>
        `;

        setTimeout(() => {
          submitBtn.innerHTML = `
            <span class="relative z-10 flex items-center gap-2 text-[#1e0e1a] font-bold font-headline uppercase tracking-wide">
              <span class="material-symbols-outlined text-sm">check_circle</span>
              Welcome to Samay
            </span>
          `;
          setTimeout(() => {
            submitBtn.innerHTML = originalContent;
            submitBtn.disabled = false;
          }, 1500);
        }, 1000);
      }
    </script>

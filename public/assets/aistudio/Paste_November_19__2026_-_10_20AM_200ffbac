      input.focus();
    }
  }

  function handleKey(e) {
    if (e.key === 'Enter') {
      dispatchMessage();
    }
  }

  function dispatchMessage() {
    const input = document.getElementById('assistantInput');
    if (!input || !input.value.trim()) return;
    
    const toast = document.getElementById('bookingToast');
    const toastHeading = document.getElementById('toastHeading');
    const toastSubtext = document.getElementById('toastSubtext');
    
    if (toast && toastHeading && toastSubtext) {
      toastHeading.textContent = "Analyzing Slot Availability";
      toastSubtext.textContent = 'Query: "' + input.value.trim() + '"';
      toast.classList.remove('hidden');
    }
    input.value = '';
  }

  function confirmSlot(slotTime, provider) {
    const toast = document.getElementById('bookingToast');
    const toastHeading = document.getElementById('toastHeading');
    const toastSubtext = document.getElementById('toastSubtext');
    
    if (toast && toastHeading && toastSubtext) {
      toastHeading.textContent = "Reserved: " + slotTime;
      toastSubtext.textContent = provider + " has placed a complimentary hold.";
      toast.classList.remove('hidden');
      
      toast.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  }

  function closeToast() {
    const toast = document.getElementById('bookingToast');
    if (toast) toast.classList.add('hidden');
  }

  function toggleVoiceInput() {
    const mic = document.getElementById('micBtn');
    const input = document.getElementById('assistantInput');
    if (mic) {
      mic.classList.toggle('text-[#CDC694]');
